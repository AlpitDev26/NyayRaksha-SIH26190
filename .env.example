# ==============================================================================
# NyayaVault - Environment Configuration Template
# Problem Statement ID: 26190 - Secure Digital Document Management System
# ==============================================================================
# IMPORTANT: This is an example template. Never commit real secrets to version control.

# Application Environment
APP_ENV=development
APP_NAME="NyayaVault — Secure Digital Document Management System"
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database Configuration
# In local development without Docker, SQLite fallback is supported:
# DATABASE_URL=sqlite+aiosqlite:///./nyayavault.db
# For production or Docker environment:
DATABASE_URL=postgresql+psycopg://nyaya_user:nyaya_secure_pass@localhost:5432/nyayavault
DATABASE_ECHO=false

# Redis Configuration (for rate limiting, caching, and background workers)
REDIS_URL=redis://localhost:6379/0

# Security & JWT Secrets (Replace with generated cryptographically secure random keys)
JWT_SECRET=change_me_to_a_minimum_32_character_cryptographically_secure_random_string_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Object Storage Configuration (S3 / MinIO / Local AES-256 Storage Adapter)
STORAGE_MODE=local
# STORAGE_MODE=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=nyayavault-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-south-1
S3_PRESIGNED_URL_TTL_SECONDS=300
STORAGE_ENCRYPTION_ENABLED=true
STORAGE_LOCAL_DIR=./storage_vault

# Virus Scanning (ClamAV daemon or Local Heuristic Engine)
SCANNER_MODE=local
# SCANNER_MODE=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Permissioned Blockchain Configuration (Hyperledger Fabric Adapter)
BLOCKCHAIN_MODE=mock
# BLOCKCHAIN_MODE=fabric
FABRIC_GATEWAY_URL=localhost:7051
FABRIC_CHANNEL=nyayavaultchannel
FABRIC_CHAINCODE=nyayavaultcc
FABRIC_MSP_ID=Org1MSP
FABRIC_CERT_PATH=./infra/fabric/crypto-config/peerOrganizations/org1.nyayavault.gov/users/User1@org1.nyayavault.gov/msp/signcerts/User1@org1.nyayavault.gov-cert.pem
FABRIC_KEY_PATH=./infra/fabric/crypto-config/peerOrganizations/org1.nyayavault.gov/users/User1@org1.nyayavault.gov/msp/keystore/priv_sk
FABRIC_TLS_CERT_PATH=./infra/fabric/crypto-config/peerOrganizations/org1.nyayavault.gov/peers/peer0.org1.nyayavault.gov/tls/ca.crt

# AI / OCR / Redaction Configuration
AI_MODE=local
# AI_MODE=external
OPENAI_API_KEY=
OCR_ENABLED=true
MAX_FILE_SIZE_MB=25

# Notifications & SMTP Configuration (Console / Mock provider by default)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nyayavault.local
